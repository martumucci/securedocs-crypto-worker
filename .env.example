# Required — the worker fails fast at startup if these are missing.
REDIS__URL=redis://localhost:6379
RABBITMQ__URL=amqp://securedocs:securedocs@localhost:5672/

# Optional — defaults shown for reference. Uncomment to override.
# REDIS__PAYLOAD_KEY_PREFIX=payload:
# RABBITMQ__SUBMITTED_QUEUE=securedocs.document-submitted
# RABBITMQ__PROCESSED_EXCHANGE=SecureDocs.Application.Documents.IntegrationEvents:DocumentProcessedIntegrationEvent
# RABBITMQ__PREFETCH_COUNT=1
# KEYS__PRIVATE_KEY_PATH=./keys/ed25519.private
# KEYS__PUBLIC_KEY_PATH=./keys/ed25519.public
# HEALTHCHECK__PORT=8080
